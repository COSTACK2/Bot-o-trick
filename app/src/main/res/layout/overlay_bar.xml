<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/fullBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bar"
        android:padding="8dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <EditText
                android:id="@+id/inputDpiAlto"
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:hint="DPI alto"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="12sp"
                android:background="@drawable/bg_input"
                android:padding="4dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <EditText
                android:id="@+id/inputDpiNormal"
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:hint="DPI normal"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="12sp"
                android:background="@drawable/bg_input"
                android:padding="4dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTrick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trick"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btnMinimizar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_minimize"
            android:contentDescription="Minimizar" />

        <ImageButton
            android:id="@+id/btnFechar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_close"
            android:contentDescription="Fechar" />
    </LinearLayout>

    <TextView
        android:id="@+id/minimizedButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circle_button"
        android:gravity="center"
        android:text="T"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:visibility="gone"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
